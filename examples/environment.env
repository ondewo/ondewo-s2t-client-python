# =============================================================================
# ONDEWO S2T Python client SDK — examples environment template
# =============================================================================
# This file is a NON-SECRET template. Copy it, fill in real values locally, and
# NEVER commit real secrets. Every example under examples/ loads this file via
# python-dotenv (path resolved relative to the example script, so the working
# directory does not matter) and reads the variables below with os.getenv(...).
#
# Canonical variable names — one name per concept, reused across every ONDEWO
# SDK example. Do not introduce synonyms (no HOST vs HOSTNAME vs grpcHost drift).
# -----------------------------------------------------------------------------

# --- Connection ---------------------------------------------------------------
# gRPC host and port of the ONDEWO S2T server.
ONDEWO_HOST=localhost
ONDEWO_PORT=50655

# --- Secure channel -----------------------------------------------------------
# Whether to open a TLS-secured gRPC channel (true/false).
ONDEWO_USE_SECURE_CHANNEL=false
# Optional path to a PEM certificate file used for the secure channel. Leave
# blank for an insecure channel. When set, ONDEWO_USE_SECURE_CHANNEL should be true.
ONDEWO_GRPC_CERT=

# --- Basic auth (optional; not required for the current S2T examples) ---------
ONDEWO_USER_NAME=
ONDEWO_PASSWORD=
ONDEWO_HTTP_BASIC_AUTH_TOKEN=

# --- Keycloak headless offline-token (D18) login ------------------------------
# Fill in all of KEYCLOAK_URL, KEYCLOAK_REALM, KEYCLOAK_CLIENT_ID,
# KEYCLOAK_USER_NAME and KEYCLOAK_PASSWORD together to authenticate, or leave
# them all blank for an unauthenticated client. A partial set raises ValueError.
KEYCLOAK_URL=
# Typical CCAI platform values: KEYCLOAK_REALM=ondewo-ccai-platform,
# KEYCLOAK_CLIENT_ID=ondewo-nlu-cai-sdk-public. Left blank here so the template
# runs unauthenticated by default (setting only some Keycloak fields raises ValueError).
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
# The public SDK client has no secret (D18/Q1); leave blank unless your realm
# uses a confidential client.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_USER_NAME=
KEYCLOAK_PASSWORD=
# Verify the Keycloak server's TLS certificate on the token-endpoint call.
KEYCLOAK_VERIFY_SSL=true

# --- S2T service-specific -----------------------------------------------------
# Path to the audio file to transcribe. Relative paths are resolved against the
# examples/ directory. Defaults per example if left blank.
ONDEWO_S2T_AUDIO_FILE=audiofiles/sample_1.wav
# Optional pipeline (model setup) id to use. Leave blank to auto-pick the first
# pipeline returned by the server.
ONDEWO_S2T_PIPELINE_ID=
